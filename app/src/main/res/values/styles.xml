<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================ Type ============================ -->
    <!--
      Inter is the design font. Drop inter_*.ttf into res/font and add
      android:fontFamily="@font/inter" here to switch the whole app over —
      no layout needs to change.
    -->
    <style name="TextAppearance.Synergy.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Synergy.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Synergy.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Synergy.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
    </style>

    <style name="TextAppearance.Synergy.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="TextAppearance.Synergy.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- ========================== Buttons =========================== -->
    <style name="Widget.Synergy.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="backgroundTint">@color/synergy_blue_700</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">@dimen/icon_md</item>
    </style>

    <style name="Widget.Synergy.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/synergy_blue_700</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="strokeColor">@color/synergy_blue_700</item>
        <item name="strokeWidth">1.4dp</item>
        <item name="iconTint">@color/synergy_blue_700</item>
        <item name="iconSize">@dimen/icon_md</item>
    </style>

    <!-- Quiet fill used inside cards, e.g. "View today's gate log" -->
    <style name="Widget.Synergy.Button.Ghost" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_sm</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/synergy_blue_800</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="backgroundTint">@color/synergy_blue_50</item>
        <item name="iconTint">@color/synergy_blue_800</item>
        <item name="iconSize">@dimen/icon_sm</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Synergy.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_sm</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/state_absent</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="backgroundTint">@color/state_absent_bg</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Synergy.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/synergy_blue_700</item>
    </style>

    <style name="Widget.Synergy.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/synergy_blue_700</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- =========================== Cards ============================ -->
    <style name="Widget.Synergy.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <!-- The one card per screen that overlaps the blue header sheet -->
    <style name="Widget.Synergy.Card.Lift">
        <item name="cardElevation">@dimen/card_elevation_lift</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- =========================== Chips ============================ -->
    <style name="Widget.Synergy.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:clickable">false</item>
        <item name="android:checkable">false</item>
        <item name="chipIconSize">13dp</item>
    </style>

    <!-- Horizontal filter row: Medical / Personal / Emergency / Official duty -->
    <style name="Widget.Synergy.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
    </style>

    <!-- ======================== Text fields ========================= -->
    <style name="Widget.Synergy.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/synergy_blue_700</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/synergy_blue_700</item>
        <item name="boxBackgroundColor">@color/surface_card</item>
    </style>

    <!-- ========================= Bottom nav ========================= -->
    <style name="Widget.Synergy.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.Synergy.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">@color/surface_card</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Synergy.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/synergy_blue_50</item>
    </style>

    <!-- ========================= Progress =========================== -->
    <style name="Widget.Synergy.Progress.Bar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="trackColor">@color/divider</item>
        <item name="indicatorColor">@color/synergy_blue_600</item>
        <!-- Material 1.12 puts a dot at the end of the track. On a leave-balance
             bar it reads as a stray mark, not as a scale end. -->
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

</resources>
