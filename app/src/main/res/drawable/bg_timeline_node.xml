<?xml version="1.0" encoding="utf-8"?>
<!--
  Ring on the gate-log timeline. GateLogAdapter mutates the stroke colour per
  event direction (green = IN, slate = OUT), so only the shape lives here.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/surface_card" />
    <stroke
        android:width="3dp"
        android:color="@color/state_present" />
</shape>
