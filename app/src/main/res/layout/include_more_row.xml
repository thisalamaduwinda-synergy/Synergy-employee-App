<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the "More" list: icon tile, label, and either a count or a chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/tap_target"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_14"
    android:paddingVertical="@dimen/space_10">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/avatar_sm"
        android:layout_height="@dimen/avatar_sm"
        android:background="@drawable/bg_rect_r10"
        android:backgroundTint="@color/synergy_blue_50"
        android:contentDescription="@null"
        android:padding="@dimen/space_6"
        app:tint="@color/synergy_blue_700"
        tools:src="@drawable/ic_wallet" />

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_10"
        android:layout_weight="1"
        android:textColor="@color/ink"
        android:textSize="13.5sp"
        tools:text="Payslips &amp; tax" />

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_count"
        style="@style/Widget.Synergy.Chip.Status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:text="2"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/muted" />

</LinearLayout>
