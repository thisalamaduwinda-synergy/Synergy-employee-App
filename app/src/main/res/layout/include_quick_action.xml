<?xml version="1.0" encoding="utf-8"?>
<!-- One tile in the home screen's four-up shortcut row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_6">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="@dimen/space_4"
        android:background="@drawable/bg_rect_r12"
        android:backgroundTint="@color/synergy_blue_50"
        android:contentDescription="@null"
        android:padding="@dimen/space_16"
        app:tint="@color/synergy_blue_700"
        tools:src="@drawable/ic_calendar" />

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:gravity="center"
        android:lines="2"
        android:textColor="@color/ink_secondary"
        android:textSize="10.5sp"
        tools:text="Apply leave" />

</LinearLayout>
