<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Synergy.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/avatar_sm"
                android:layout_height="@dimen/avatar_sm"
                android:background="@drawable/bg_rect_r10"
                android:backgroundTint="@color/synergy_blue_50"
                android:contentDescription="@null"
                android:padding="@dimen/space_6"
                android:src="@drawable/ic_megaphone"
                app:tint="@color/synergy_blue_700" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="GMP refresher training" />

                <TextView
                    android:id="@+id/text_meta"
                    style="@style/TextAppearance.Synergy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textSize="11sp"
                    tools:text="Quality Assurance · 1 day ago" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/text_body"
            style="@style/TextAppearance.Synergy.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:lineSpacingMultiplier="1.35"
            android:maxLines="3"
            android:ellipsize="end"
            android:textSize="13sp"
            tools:text="Mandatory for all production and QA staff. Two batches: 9.00 a.m. and 2.00 p.m." />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_action"
            style="@style/Widget.Synergy.Chip.Status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:visibility="gone"
            tools:text="Action needed"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
