<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/leave_title"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pulled up so the balance card overlaps the header. See the note in
             fragment_attendance.xml for why the margin lives here. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-38dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingBottom="88dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Balance first, history second: the number people open
                         the screen for is "how many days do I have left". -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Synergy.Card.Lift"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_14">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/text_balance_year"
                                    style="@style/TextAppearance.Synergy.Overline"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    tools:text="Balance · 2026" />

                                <TextView
                                    android:id="@+id/text_days_left"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/synergy_blue_700"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold"
                                    tools:text="22 days left" />
                            </LinearLayout>

                            <include
                                android:id="@+id/bucket_annual"
                                layout="@layout/include_leave_bucket" />

                            <include
                                android:id="@+id/bucket_casual"
                                layout="@layout/include_leave_bucket" />

                            <include
                                android:id="@+id/bucket_medical"
                                layout="@layout/include_leave_bucket" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/TextAppearance.Synergy.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:text="@string/leave_my_requests" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Synergy.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/space_14">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/list_requests"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                tools:itemCount="3"
                                tools:listitem="@layout/item_leave_request" />

                            <TextView
                                android:id="@+id/text_empty"
                                style="@style/TextAppearance.Synergy.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:paddingVertical="@dimen/space_24"
                                android:text="@string/leave_no_requests"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@drawable/bg_rect_r12"
                        android:backgroundTint="@color/synergy_blue_50"
                        android:lineSpacingMultiplier="1.4"
                        android:padding="@dimen/space_12"
                        android:text="@string/leave_poya_note"
                        android:textColor="@color/synergy_blue_800"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_apply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:contentDescription="@string/apply_leave_title"
        android:src="@drawable/ic_plus"
        app:backgroundTint="@color/synergy_blue_700"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
