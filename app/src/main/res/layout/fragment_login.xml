<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingTop="@dimen/space_32"
        app:layout_constraintBottom_toTopOf="@id/text_version"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="480dp"
            android:orientation="vertical">

            <!--
              The mark contains black and orange, so it always sits on white
              rather than being knocked out to a single colour on the blue.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="10dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_margin="@dimen/space_20"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/cd_logo"
                    android:src="@drawable/logo_full" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="@string/login_subtitle"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:alpha="0.92" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Synergy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_employee_id"
                        style="@style/Widget.Synergy.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_employee_id"
                        app:startIconDrawable="@drawable/ic_users">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_employee_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLines="1"
                            tools:text="SPC-1042" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_password"
                        style="@style/Widget.Synergy.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:hint="@string/login_password"
                        app:endIconMode="password_toggle"
                        app:startIconDrawable="@drawable/ic_lock">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_login"
                        style="@style/Widget.Synergy.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/login_action" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/space_12"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/synergy_blue_700"
                        app:indicatorSize="28dp"
                        app:trackThickness="3dp"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/row_biometric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_14"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="@dimen/tap_target"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_lg"
                            android:layout_height="@dimen/icon_lg"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_face"
                            app:tint="@color/synergy_blue_700" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/login_biometric"
                            android:textColor="@color/synergy_blue_700"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_24"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/tap_target"
                android:paddingVertical="@dimen/space_10"
                android:text="@string/login_first_time"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/text_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingBottom="@dimen/space_16"
        android:textColor="@color/white"
        android:textSize="10.5sp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="v1.0.0 · Synergy Pharmaceuticals Corporation (Pvt) Ltd" />

</androidx.constraintlayout.widget.ConstraintLayout>
