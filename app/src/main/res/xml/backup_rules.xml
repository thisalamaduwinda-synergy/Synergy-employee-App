<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled app-wide (allowBackup="false") because the app holds a JWT
  and cached payroll data. This file exists so the manifest reference resolves.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
